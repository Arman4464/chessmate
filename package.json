{
  "name": "chessmate",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://github.com/Arman4464/chessmate",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node server.js",
    "serve": "node server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:review": "node tests/verify_unseen_game.js",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist -t"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "chess.js": "^1.4.0",
    "howler": "^2.2.4",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/howler": "^2.2.13",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.4.0",
    "gh-pages": "^6.3.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "unrs-resolver": true,
    "unrs-resolver@1.12.2": true
  }
}
